<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hxx.mapper.PersonMapper">

    <sql id="mySelectSql">
        select username,sex,age from tb_person
    </sql>

    <select id="findAllMy" resultType="person">
        <include refid="mySelectSql"/>
    </select>

    <insert id="insertPersonBatch" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tb_person(username, sex)
        <foreach collection="list" item="person" separator=","
                 open="values" index="myIndex">
            (#{person.username}, #{person.sex})
        </foreach>
    </insert>

    <select id="findAllChoose" resultType="person">
        select * from tb_person
        where
        <choose>
            <!--<when test="username != null">username=#{username}</when>-->
            <when test="age &gt; 11">age &gt; 11</when>
            <otherwise>1=1</otherwise>
        </choose>
    </select>


    <select id="findAllTrim">
        select * from tb_person
        <trim prefix="where" suffixOverrides="and|or">
            <if test="username != null">
                username=#{username} and
            </if>
            <if test="age &gt; 11">
                age>#{age} and
            </if>
            <if test="sex!=null">
                sex concat('%',#{sex},'%')
            </if>
        </trim>
    </select>

    <update id="updatePerson">
        update tb_person
        <set>
            <if test="username!=null">
              username=#{username},
            </if>
            <if test="sex!=null">
                sex=#{sex},
            </if>
            <if test="age!=null">
                age=#{age},
            </if>
        </set>
        <where>
            id=#{id}
        </where>
    </update>

    <select id="findAllPerson1" resultType="person">
        select * from tb_person
        <where>
            <if test="username != null">
                and username like concat('%',#{username},'%')
            </if>
            <if test="age &gt; 12">
                and age>#{age}
            </if>
        </where>
    </select>

    <select id="show" parameterType="int" resultMap="cardPersonMapper">
        select * from tb_person person where person.id=#{id}
    </select>
    <resultMap id="cardPersonMapper" type="person">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <association property="card" column="id"  javaType="IdCard"
                     select="com.hxx.mapper.IdCardMapper.findById">
        </association>
    </resultMap>

    <insert id="insertPerson" useGeneratedKeys="true" keyProperty="id">
        insert into tb_person(name) values(#{name})
    </insert>

    <select id="show1" parameterType="int" resultMap="cardPersonMapper1">
        select * from tb_person person
                          join tb_idcard card on person.id=card.id
        where person.id=#{id}
    </select>
    <resultMap id="cardPersonMapper1" type="person">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <association property="card" javaType="IdCard">
            <id column="id" property="id"/>
            <result property="code" column="code"/>
        </association>
    </resultMap>
</mapper>